#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#SBATCH --gpus-per-node=4
#SBATCH --array=0-1
#SBATCH --time=06:00:00
#SBATCH --account=p201442
#SBATCH --partition=gpu
#SBATCH --qos=default
#SBATCH --job-name=memory-games-pilot
#SBATCH --chdir=/project/home/p201442/u104493
#SBATCH --output=/project/home/p201442/u104493/slurm-logs/%x-%A_%a.out
#SBATCH --error=/project/home/p201442/u104493/slurm-logs/%x-%A_%a.err

# Concentration / Minesweeper pilot: 100k steps per seed (20 rounds x 5000).
# Each array task uses one node, four GPUs and four Python processes, with
# three vmapped seeds per process. Array 0 = Concentration, 1 = Minesweeper.
#   GPU 0: sac       no lambda branches
#   GPU 1: critics   lambda branches, discrepancy coefficient 0
#   GPU 2: ld0.01    lambda branches, discrepancy coefficient 0.01
#   GPU 3: ld0.1     lambda branches, discrepancy coefficient 0.1
# All four methods share the training seed base; Minesweeper adds 1000000.
# H128, batch32, sequence32, lambda tail32; burn-in is inferred as a full
# episode by the runner (deliberately omit --burn-in-length).
#
# Submit from the repository root; create the Slurm log directory first:
#   mkdir -p /project/home/p201442/u104493/slurm-logs
#   sbatch examples/lambda-envs/memory_games_pilot.slrm                 # 8 GPUs, both games
#   sbatch --array=0-1%1 examples/lambda-envs/memory_games_pilot.slrm   # 4 GPUs, two waves
#   sbatch --array=0 examples/lambda-envs/memory_games_pilot.slrm       # Concentration only
#   sbatch --array=1 examples/lambda-envs/memory_games_pilot.slrm       # Minesweeper only
#   sbatch --export=ALL,ROUNDS=200 examples/lambda-envs/memory_games_pilot.slrm  # 1M steps
#
# Override ROUNDS, TRAIN_STEPS, NUM_SEEDS, ALPHA, BASE_SEED, EVAL_EVERY,
# EVAL_EPISODES and CHECKPOINT_EVERY through the submission environment.
# CHECKPOINT_EVERY defaults to 5 rounds (25k steps); 0 disables checkpoints.
# RUN_ROOT defaults to /project/home/p201442/$USER/runs/memory-games-<array-job-id>.
# Each condition writes to RUN_ROOT/<env>/<condition>, including checkpoint.pkl.
# W&B, temporary files and library caches are under RUN_ROOT/<env>; Python
# bytecode writes are disabled so importing the home checkout creates no pyc files.
# REPO_ROOT defaults to $HOME/git/lambda-imitation; PYTHON_ENV_SCRIPT defaults
# to $HOME/envs/py314.sh. WANDB_PROJECT defaults to offline-lambda-memory-games-results.
#
# Exact checkpoint resume, retaining replay and optimizer state (replace 123456):
#   sbatch --export=ALL,ROUNDS=200,RESUME_ROOT=/project/home/p201442/$USER/runs/memory-games-123456 examples/lambda-envs/memory_games_pilot.slrm
#   sbatch --array=1 --export=ALL,ROUNDS=200,RESUME_ROOT=/project/home/p201442/$USER/runs/memory-games-123456 examples/lambda-envs/memory_games_pilot.slrm
# ROUNDS is the total target, including completed rounds. Reuse the original
# NUM_SEEDS, BASE_SEED, ALPHA, TRAIN_STEPS and model/environment configuration.
# RESUME_ROOT is explicit: every selected env/condition/checkpoint.pkl must
# exist and be readable before any process for that array task starts.
# Resumed outputs go to the new job's RUN_ROOT unless RUN_ROOT is overridden.

set -euo pipefail

case "${SLURM_ARRAY_TASK_ID:?Submit this script as a Slurm array}" in
    0)
        env_name=concentration
        env_args=(--cards 52 --types 13)
        seed_offset=0
        ;;
    1)
        env_name=minesweeper
        env_args=(--rows 6 --cols 6 --mines 6)
        seed_offset=1000000
        ;;
    *)
        printf 'Unsupported array task: %s (expected 0 or 1)\n' "$SLURM_ARRAY_TASK_ID" >&2
        exit 2
        ;;
esac

ROUNDS="${ROUNDS:-20}"
TRAIN_STEPS="${TRAIN_STEPS:-5000}"
NUM_SEEDS="${NUM_SEEDS:-3}"
ALPHA="${ALPHA:-0.01}"
BASE_SEED="${BASE_SEED:-0}"
EVAL_EVERY="${EVAL_EVERY:-1}"
EVAL_EPISODES="${EVAL_EPISODES:-32}"
CHECKPOINT_EVERY="${CHECKPOINT_EVERY:-5}"
WANDB_PROJECT="${WANDB_PROJECT:-offline-lambda-memory-games-results}"
RESUME_ROOT="${RESUME_ROOT:-}"

PROJ="/project/home/p201442/$USER"
job_id="${SLURM_ARRAY_JOB_ID:-${SLURM_JOB_ID:?Submit this script with sbatch}}"
RUN_ROOT="${RUN_ROOT:-$PROJ/runs/memory-games-$job_id}"
SCRIPT="${REPO_ROOT:-$HOME/git/lambda-imitation}/examples/lambda-envs/memory_games_sac.py"
seed=$((BASE_SEED + seed_offset))

# Keep runtime artifacts out of the inode-limited home directory, including
# libraries which would otherwise use ~/.cache, ~/.config or the submit cwd.
runtime="$RUN_ROOT/$env_name/runtime"
export PYTHONDONTWRITEBYTECODE=1
export TMPDIR="$runtime/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export XDG_CACHE_HOME="$runtime/cache"
export MPLCONFIGDIR="$XDG_CACHE_HOME/matplotlib"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/cuda"
export JAX_COMPILATION_CACHE_DIR="$XDG_CACHE_HOME/jax"
export WANDB_DIR="$RUN_ROOT/$env_name/wandb"
export WANDB_CACHE_DIR="$XDG_CACHE_HOME/wandb"
export WANDB_CONFIG_DIR="$runtime/config/wandb"
export WANDB_DATA_DIR="$runtime/wandb-data"
mkdir -p "$TMPDIR" "$MPLCONFIGDIR" "$CUDA_CACHE_PATH" \
    "$JAX_COMPILATION_CACHE_DIR" "$WANDB_DIR" "$WANDB_CACHE_DIR" \
    "$WANDB_CONFIG_DIR" "$WANDB_DATA_DIR"

source "${PYTHON_ENV_SCRIPT:-$HOME/envs/py314.sh}"
export OMP_NUM_THREADS=32                 # 128 cores / 4 processes
export XLA_PYTHON_CLIENT_PREALLOCATE=false

if [[ ! -f "$SCRIPT" ]]; then
    printf 'Runner not found: %s (set REPO_ROOT to the checkout)\n' "$SCRIPT" >&2
    exit 1
fi

names=(sac critics ld0.01 ld0.1)
methods=(sac critics ld ld)
lambda_coefs=(0 0 0.01 0.1)
args=(
    --env "$env_name"
    --rounds "$ROUNDS" --train-steps "$TRAIN_STEPS"
    --num-seeds "$NUM_SEEDS" --seed "$seed" --alpha "$ALPHA"
    --memory-hidden-dim 128 --batch-size 32 --sequence-length 32
    --lambda-truncation 32
    --eval-every "$EVAL_EVERY" --eval-episodes "$EVAL_EPISODES"
    --checkpoint-every "$CHECKPOINT_EVERY"
    --wandb --wandb-project "$WANDB_PROJECT"
)

# Preflight every checkpoint and output directory before occupying any GPUs.
outputs=()
checkpoints=()
for i in "${!names[@]}"; do
    outputs+=("$RUN_ROOT/$env_name/${names[$i]}")
    if [[ -n "$RESUME_ROOT" ]]; then
        checkpoint="$RESUME_ROOT/$env_name/${names[$i]}/checkpoint.pkl"
        if [[ ! -f "$checkpoint" || ! -r "$checkpoint" ]]; then
            printf 'Requested resume checkpoint is missing or unreadable: %s\n' "$checkpoint" >&2
            exit 1
        fi
        checkpoints+=("$checkpoint")
    fi
done
mkdir -p "$WANDB_DIR" "${outputs[@]}"

printf 'Array job %s task %s on %s: %s\n' "$job_id" "$SLURM_ARRAY_TASK_ID" "$(hostname)" "$env_name"
printf '%s matched seeds per method, base %s; %s rounds x %s steps; alpha %s\n' \
    "$NUM_SEEDS" "$seed" "$ROUNDS" "$TRAIN_STEPS" "$ALPHA"
printf 'RUN_ROOT=%s\nWANDB_DIR=%s\nWANDB_PROJECT=%s\n' "$RUN_ROOT" "$WANDB_DIR" "$WANDB_PROJECT"

pids=()
wait_all() {
    local i status result=0
    for i in "${!pids[@]}"; do
        # Guard each wait: errexit must not abandon the other GPU processes.
        if wait "${pids[$i]}"; then
            status=0
        else
            status=$?
            result=1
        fi
        printf 'GPU %s (%s) exit=%s; log: %s/run.log\n' "$i" "${names[$i]}" "$status" "${outputs[$i]}"
    done
    return "$result"
}

stop_all() {
    local status="$1" pid
    trap '' INT TERM
    for pid in "${pids[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    wait_all || true
    exit "$status"
}
trap 'stop_all 130' INT
trap 'stop_all 143' TERM

for i in "${!names[@]}"; do
    name="${names[$i]}"
    out="${outputs[$i]}"
    condition_args=(--method "${methods[$i]}" --lambda-coef "${lambda_coefs[$i]}")
    if [[ -n "$RESUME_ROOT" ]]; then
        condition_args+=(--resume-from "${checkpoints[$i]}")
        printf 'GPU %s (%s) resume: %s\n' "$i" "$name" "${checkpoints[$i]}"
    fi
    printf 'GPU %s -> %s; output: %s; checkpoint: %s/checkpoint.pkl\n' "$i" "$name" "$out" "$out"
    CUDA_VISIBLE_DEVICES="$i" python -u "$SCRIPT" \
        "${args[@]}" "${env_args[@]}" "${condition_args[@]}" \
        --output-dir "$out" \
        --wandb-run-name "memory-games-$env_name-$name-${NUM_SEEDS}seed-$job_id" \
        >> "$out/run.log" 2>&1 &
    pids+=("$!")
done

rc=0
wait_all || rc=$?
trap - INT TERM
printf 'Done, exit=%s; artifacts: %s/%s\n' "$rc" "$RUN_ROOT" "$env_name"
exit "$rc"
