#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#SBATCH --gpus-per-node=4
#SBATCH --time=24:00:00
#SBATCH --account=p201442
#SBATCH --partition=gpu
#SBATCH --qos=default
#SBATCH --job-name=pocman-sweep
#SBATCH --output=/project/home/p201442/u104493/slurm-logs/%x-%j.out

# Four concurrent W&B sweep agents, one per GPU, for the full 24 h.
#
#   wandb sweep examples/lambda-envs/sweeps/pocman_bayes.yaml   # prints a sweep id
#   sbatch pocman_sweep_agents.slrm <entity>/<project>/<sweep-id>
#
# The sweep id can also come from $SWEEP_ID.  Give the fully qualified form
# (entity/project/id) — a bare id only resolves if the default entity and
# project happen to match.
#
# Each agent pulls trials from the same sweep until the job's wall clock runs
# out, so the four GPUs stay busy without any coordination between them. If an
# agent dies (OOM, a bad trial), it is restarted; a clean exit means the sweep
# itself is finished, and that GPU then stops.

SWEEP=${1:-$SWEEP_ID}
if [ -z "$SWEEP" ]; then
    echo "usage: sbatch $0 <entity>/<project>/<sweep-id>   (or set SWEEP_ID)" >&2
    exit 2
fi

source ~/envs/py314.sh
export OMP_NUM_THREADS=32                  # 128 cores / 4 agents

# Home has a 100k-file quota and these runs write many small files, so
# everything the job produces goes to the project partition (1 TiB, 1M files).
PROJ=/project/home/p201442/$USER
export WANDB_DIR=$PROJ/wandb               # else wandb/ lands in $HOME
# The agent runs the command from the sweep config, which has no --output-dir,
# so this is the only way to keep artefacts off $HOME.  Each sweep run still
# gets its own run_<id> subdirectory underneath (see apply_sweep_config).
export PROBE_OUTPUT_DIR=$PROJ/sweeps
mkdir -p "$WANDB_DIR" "$PROBE_OUTPUT_DIR"

# `program:` in the sweep config is repo-relative, so the agents must run from
# the repo root.
cd ~/git/lambda-imitation || exit 1

echo "job $SLURM_JOB_ID on $(hostname)"
echo "sweep:      $SWEEP"
echo "artefacts:  $PROBE_OUTPUT_DIR"
echo "repo:       $(git rev-parse --short HEAD) on $(git rev-parse --abbrev-ref HEAD)"

run_agent() {
    local gpu=$1
    local tries=0
    while [ $tries -lt 50 ]; do
        CUDA_VISIBLE_DEVICES=$gpu wandb agent "$SWEEP" && {
            echo "gpu$gpu: agent exited cleanly (sweep finished or stopped)"
            return 0
        }
        tries=$((tries + 1))
        echo "gpu$gpu: agent died (attempt $tries), restarting in 30s"
        sleep 30
    done
    echo "gpu$gpu: giving up after $tries restarts"
    return 1
}

pids=()
for i in 0 1 2 3; do
    run_agent "$i" > "$PROJ/slurm-logs/agent-$SLURM_JOB_ID-gpu$i.log" 2>&1 &
    pids+=($!)
    echo "gpu$i -> agent started (log: $PROJ/slurm-logs/agent-$SLURM_JOB_ID-gpu$i.log)"
    sleep 5                                # stagger, so four wandb inits do not race
done

rc=0
for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || { rc=1; echo "gpu$i agent loop ended non-zero"; }
done
echo "done, rc=$rc"
exit $rc
