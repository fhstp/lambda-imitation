#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#SBATCH --gpus-per-node=4
#SBATCH --array=0-2%1
#SBATCH --time=02:00:00
#SBATCH --account=p201442
#SBATCH --partition=gpu
#SBATCH --qos=short
#SBATCH --job-name=memory-games-followup
#SBATCH --chdir=/project/home/p201442/u104493
#SBATCH --output=/project/home/p201442/u104493/slurm-logs/%x-%A_%a.out
#SBATCH --error=/project/home/p201442/u104493/slurm-logs/%x-%A_%a.err

# Short diagnostic follow-ups to pilot 5251683, all from fresh initialization.
# Three four-GPU waves keep this job at four GPUs while the Minesweeper 1M
# continuation uses another four. Each condition runs three seeds for 100k steps.
#
# Task 0, Minesweeper: SAC / critics-only at alpha 0.03 and 0.1, FE lr 1e-4.
# Task 1, Minesweeper: SAC / critics-only at alpha 0.01 and 0.03, FE lr 1e-5.
# Task 2, Concentration: SAC partial GRU / remembered-history identity controls
#                       at alpha 0.01 and 0.03, FE lr 1e-5 throughout.
# Optional task 3, Minesweeper: matched slower-FE comparison to 500k steps.
#   Resume SAC / critics-only from BASELINE_ROOT; start LD 0.03 / 0.1 fresh.
#   All four use alpha 0.01, FE lr 1e-5, and the original three tuning seeds.
#   Task 3 is NOT included in the default array; select --array=3 explicitly.
# Optional task 4 continues all four matched runs from MATCHED_RESUME_ROOT to
# 1M total steps. Set WANDB_RUN_IDS to their four comma-separated existing IDs
# and WANDB_GROUP_OVERRIDE to the original group to continue the same curves.
# The original alpha 0.01 / FE lr 1e-4 baselines already exist in the first pilot.
# All other model, replay and optimizer settings match memory_games_pilot.slrm.
# Seeds match that pilot: 0..2 for Concentration, 1000000..1000002 for Minesweeper.
# These are tuning seeds, not the later independent confirmation seed set.
#
#   sbatch examples/lambda-envs/memory_games_followup.slrm
#   sbatch --array=0-1%1 examples/lambda-envs/memory_games_followup.slrm  # Minesweeper only
#   sbatch --array=2 examples/lambda-envs/memory_games_followup.slrm    # Concentration only
#   sbatch --array=3 --dependency=afterany:5251797 \
#     --export=ALL,BASELINE_ROOT=/project/home/p201442/$USER/runs/memory-games-followup-5251797/minesweeper/low-fe-lr \
#     examples/lambda-envs/memory_games_followup.slrm
# ROUNDS/TRAIN_STEPS/NUM_SEEDS/BASE_SEED/EVAL_EVERY/EVAL_EPISODES/CHECKPOINT_EVERY
# can be overridden with sbatch --export=ALL,... . ROUNDS=20 is 100k steps.
# All runtime artifacts, caches and logs go to project storage; no pyc writes.

set -euo pipefail

default_rounds=20
lambda_coefs=(0 0 0 0)
checkpoints=("" "" "" "")
wandb_ids=("" "" "" "")
case "${SLURM_ARRAY_TASK_ID:?Submit this script as a Slurm array}" in
    0)
        env_name=minesweeper
        cohort=entropy
        env_args=(--rows 6 --cols 6 --mines 6)
        seed_offset=1000000
        names=(sac-a0.03 critics-a0.03 sac-a0.1 critics-a0.1)
        methods=(sac critics sac critics)
        alphas=(0.03 0.03 0.1 0.1)
        fe_lrs=(1e-4 1e-4 1e-4 1e-4)
        memories=(gru gru gru gru)
        remembered=(0 0 0 0)
        ;;
    1)
        env_name=minesweeper
        cohort=low-fe-lr
        env_args=(--rows 6 --cols 6 --mines 6)
        seed_offset=1000000
        names=(sac-a0.01 critics-a0.01 sac-a0.03 critics-a0.03)
        methods=(sac critics sac critics)
        alphas=(0.01 0.01 0.03 0.03)
        fe_lrs=(1e-5 1e-5 1e-5 1e-5)
        memories=(gru gru gru gru)
        remembered=(0 0 0 0)
        ;;
    2)
        env_name=concentration
        cohort=stability-history
        env_args=(--cards 52 --types 13)
        seed_offset=0
        names=(partial-a0.01 history-a0.01 partial-a0.03 history-a0.03)
        methods=(sac sac sac sac)
        alphas=(0.01 0.01 0.03 0.03)
        fe_lrs=(1e-5 1e-5 1e-5 1e-5)
        memories=(gru identity gru identity)
        remembered=(0 1 0 1)
        ;;
    3|4)
        env_name=minesweeper
        cohort=matched-ld
        env_args=(--rows 6 --cols 6 --mines 6)
        seed_offset=1000000
        default_rounds=100
        names=(baseline extra-critics LD-small LD-large)
        methods=(sac critics ld ld)
        alphas=(0.01 0.01 0.01 0.01)
        fe_lrs=(1e-5 1e-5 1e-5 1e-5)
        lambda_coefs=(0 0 0.03 0.1)
        memories=(gru gru gru gru)
        remembered=(0 0 0 0)
        if [[ "$SLURM_ARRAY_TASK_ID" == 3 ]]; then
            : "${BASELINE_ROOT:?Set BASELINE_ROOT to the completed low-fe-lr cohort}"
            checkpoints[0]="$BASELINE_ROOT/sac-a0.01/checkpoint.pkl"
            checkpoints[1]="$BASELINE_ROOT/critics-a0.01/checkpoint.pkl"
        else
            default_rounds=200
            : "${MATCHED_RESUME_ROOT:?Set MATCHED_RESUME_ROOT to the completed matched-ld cohort}"
            : "${WANDB_RUN_IDS:?Set four comma-separated existing W&B run IDs}"
            : "${WANDB_GROUP_OVERRIDE:?Set the existing W&B group}"
            IFS=',' read -r -a wandb_ids <<< "$WANDB_RUN_IDS"
            if [[ "${#wandb_ids[@]}" != 4 ]]; then
                printf 'WANDB_RUN_IDS must contain four comma-separated IDs\n' >&2
                exit 2
            fi
            for i in "${!names[@]}"; do
                if [[ -z "${wandb_ids[$i]}" ]]; then
                    printf 'Missing W&B ID for %s\n' "${names[$i]}" >&2
                    exit 2
                fi
                checkpoints[$i]="$MATCHED_RESUME_ROOT/${names[$i]}/checkpoint.pkl"
            done
        fi
        ;;
    *)
        printf 'Unsupported array task: %s (expected 0 through 4)\n' "$SLURM_ARRAY_TASK_ID" >&2
        exit 2
        ;;
esac

ROUNDS="${ROUNDS:-$default_rounds}"
TRAIN_STEPS="${TRAIN_STEPS:-5000}"
NUM_SEEDS="${NUM_SEEDS:-3}"
BASE_SEED="${BASE_SEED:-0}"
EVAL_EVERY="${EVAL_EVERY:-1}"
EVAL_EPISODES="${EVAL_EPISODES:-64}"
CHECKPOINT_EVERY="${CHECKPOINT_EVERY:-5}"
WANDB_PROJECT="${WANDB_PROJECT:-offline-lambda-memory-games-results}"

PROJ="/project/home/p201442/$USER"
job_id="${SLURM_ARRAY_JOB_ID:-${SLURM_JOB_ID:?Submit this script with sbatch}}"
RUN_ROOT="${RUN_ROOT:-$PROJ/runs/memory-games-followup-$job_id}"
REPO_ROOT="${REPO_ROOT:-$HOME/git/lambda-imitation}"
SCRIPT="$REPO_ROOT/examples/lambda-envs/memory_games_sac.py"
seed=$((BASE_SEED + seed_offset))

for checkpoint in "${checkpoints[@]}"; do
    if [[ -n "$checkpoint" && ! -r "$checkpoint" ]]; then
        printf 'Resume checkpoint missing or unreadable: %s\n' "$checkpoint" >&2
        exit 1
    fi
done

runtime="$RUN_ROOT/$env_name/$cohort/runtime"
export PYTHONDONTWRITEBYTECODE=1
export TMPDIR="$runtime/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export XDG_CACHE_HOME="$runtime/cache"
export MPLCONFIGDIR="$XDG_CACHE_HOME/matplotlib"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/cuda"
export JAX_COMPILATION_CACHE_DIR="$XDG_CACHE_HOME/jax"
export WANDB_DIR="$RUN_ROOT/$env_name/$cohort/wandb"
export WANDB_CACHE_DIR="$XDG_CACHE_HOME/wandb"
export WANDB_CONFIG_DIR="$runtime/config/wandb"
export WANDB_DATA_DIR="$runtime/wandb-data"
export WANDB_RUN_GROUP="${WANDB_GROUP_OVERRIDE:-memory-games-$env_name-$cohort-$job_id}"
mkdir -p "$TMPDIR" "$MPLCONFIGDIR" "$CUDA_CACHE_PATH" \
    "$JAX_COMPILATION_CACHE_DIR" "$WANDB_DIR" "$WANDB_CACHE_DIR" \
    "$WANDB_CONFIG_DIR" "$WANDB_DATA_DIR"

source "${PYTHON_ENV_SCRIPT:-$HOME/envs/py314.sh}"
export OMP_NUM_THREADS=32
export XLA_PYTHON_CLIENT_PREALLOCATE=false

if [[ ! -f "$SCRIPT" ]]; then
    printf 'Runner not found: %s\n' "$SCRIPT" >&2
    exit 1
fi

args=(
    --env "$env_name" --rounds "$ROUNDS" --train-steps "$TRAIN_STEPS"
    --num-seeds "$NUM_SEEDS" --seed "$seed"
    --memory-hidden-dim 128 --batch-size 32 --sequence-length 32
    --lambda-truncation 32
    --eval-every "$EVAL_EVERY" --eval-episodes "$EVAL_EPISODES"
    --checkpoint-every "$CHECKPOINT_EVERY"
    --wandb --wandb-project "$WANDB_PROJECT"
)
outputs=()
for name in "${names[@]}"; do
    outputs+=("$RUN_ROOT/$env_name/$cohort/$name")
done
mkdir -p "${outputs[@]}"

printf 'Array job %s task %s on %s: %s / %s\n' \
    "$job_id" "$SLURM_ARRAY_TASK_ID" "$(hostname)" "$env_name" "$cohort"
printf '%s matched seeds per condition, base %s; %s rounds x %s steps\n' \
    "$NUM_SEEDS" "$seed" "$ROUNDS" "$TRAIN_STEPS"
printf 'Code commit: %s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD)"
printf 'RUN_ROOT=%s\nWANDB_DIR=%s\n' "$RUN_ROOT" "$WANDB_DIR"

pids=()
wait_all() {
    local i status result=0
    for i in "${!pids[@]}"; do
        if wait "${pids[$i]}"; then
            status=0
        else
            status=$?
            result=1
        fi
        printf 'GPU %s (%s) exit=%s; log: %s/run.log\n' \
            "$i" "${names[$i]}" "$status" "${outputs[$i]}"
    done
    return "$result"
}

stop_all() {
    local status="$1" pid
    trap '' INT TERM
    for pid in "${pids[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    wait_all || true
    exit "$status"
}
trap 'stop_all 130' INT
trap 'stop_all 143' TERM

for i in "${!names[@]}"; do
    tracking_env=()
    run_name="memory-games-$env_name-$cohort-${names[$i]}-${NUM_SEEDS}seed-$job_id"
    condition_args=(
        --method "${methods[$i]}" --alpha "${alphas[$i]}"
        --fe-lr "${fe_lrs[$i]}" --memory-type "${memories[$i]}"
        --lambda-coef "${lambda_coefs[$i]}"
    )
    if [[ -n "${checkpoints[$i]}" ]]; then
        condition_args+=(--resume-from "${checkpoints[$i]}")
        printf 'GPU %s (%s) resume: %s\n' "$i" "${names[$i]}" "${checkpoints[$i]}"
    fi
    if [[ -n "${wandb_ids[$i]}" ]]; then
        tracking_env=("WANDB_RUN_ID=${wandb_ids[$i]}" "WANDB_RESUME=must")
        run_name=$(python -c 'import json,sys; from pathlib import Path; print(json.loads((Path(sys.argv[1]).parent / "config.json").read_text())["wandb_run_name"])' "${checkpoints[$i]}")
        printf 'GPU %s continues W&B run %s\n' "$i" "${wandb_ids[$i]}"
    fi
    if [[ "${remembered[$i]}" == 1 ]]; then
        condition_args+=(--remember)
    fi
    out="${outputs[$i]}"
    printf 'GPU %s -> %s; alpha=%s FE-lr=%s LD-weight=%s memory=%s remembered=%s; output: %s\n' \
        "$i" "${names[$i]}" "${alphas[$i]}" "${fe_lrs[$i]}" \
        "${lambda_coefs[$i]}" "${memories[$i]}" "${remembered[$i]}" "$out"
    env CUDA_VISIBLE_DEVICES="$i" "${tracking_env[@]}" python -u "$SCRIPT" \
        "${args[@]}" "${env_args[@]}" "${condition_args[@]}" \
        --output-dir "$out" \
        --wandb-run-name "$run_name" \
        >> "$out/run.log" 2>&1 &
    pids+=("$!")
done

rc=0
wait_all || rc=$?
trap - INT TERM
printf 'Done, exit=%s; artifacts: %s/%s/%s\n' "$rc" "$RUN_ROOT" "$env_name" "$cohort"
exit "$rc"
