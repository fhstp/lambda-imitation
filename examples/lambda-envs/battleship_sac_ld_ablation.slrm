#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#SBATCH --gpus-per-node=4
#SBATCH --time=06:00:00
#SBATCH --account=p201442
#SBATCH --partition=gpu
#SBATCH --qos=short
#SBATCH --job-name=bbp-ablate
#SBATCH --output=%x-%j.out

# Battleship ablation on top of a fixed 20k expert prefill: does the SAC entropy
# backup help, and does the lambda-discrepancy help?  Two factors, four runs,
# one per GPU, everything else identical:
#
#   gpu0  sac-ld      --use-sac     --lambda-coef 0.01
#   gpu1  sac-nold    --use-sac     --lambda-coef 0
#   gpu2  nosac-ld    --no-use-sac  --lambda-coef 0.01
#   gpu3  nosac-nold  --no-use-sac  --lambda-coef 0
#
# --use-sac controls ONLY whether the entropy term enters the SAC critic's
# bootstrap target (soft vs hard Bellman backup); the actor keeps its entropy
# term in both cases.
#
# --lambda-coef 0 is an ablation of the DISCREPANCY TERM, not of the lambda
# branch: the two lambda-critics are still built and still trained on their own
# Retrace targets, so they still shape the shared memory through those value
# losses.  Only the (Q1-Q2)^2 pressure is removed.  For the stronger ablation
# that removes the lambda critics entirely, swap --lambda-coef 0 for
# --no-approximate-lambda in EXTRA below.
#
# 5x5 with ships 3,2, where the reference numbers exist: Bayes clears in ~13.3
# shots, uniform random ~21.7, reference PPO+LD needs ~1M env steps.  Return
# scale is rows*cols + 1 - shots, so ~12.7 at Bayes level.
#
# qos=short caps at 06:00:00; use --qos=default (2 days) for a longer version.
# Per-round metrics go to W&B as they happen, so a wall-clock kill still leaves
# a usable curve.

source ~/envs/py314.sh
export OMP_NUM_THREADS=32                  # 128 cores / 4 processes

# ── knobs ────────────────────────────────────────────────────────────────────
NAMES=(sac-ld sac-nold nosac-ld nosac-nold)
EXTRA=("--use-sac --lambda-coef 0.01"
       "--use-sac --lambda-coef 0.0"
       "--no-use-sac --lambda-coef 0.01"
       "--no-use-sac --lambda-coef 0.0")
PREFILL=20000                              # fixed expert warm start for all four
ROWS=5
COLS=5
SHIPS=3,2
ROUNDS=50
TRAIN_STEPS=5000                           # 250k env steps per seed
NUM_SEEDS=5
PROBE_EVAL_INTERVAL=10
OFFLINE=""                                 # set to "--offline" to train the same
                                           # four cells with zero env interaction
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT=~/git/lambda-imitation/examples/lambda-envs/battleship_board_probe.py
RUNDIR=~/runs/$SLURM_JOB_ID
mkdir -p "$RUNDIR"

# Random base seed per submission.  Processes are spaced 1e6 apart: the probe
# derives its keys as seed+40000 / seed+50000 / seed+500000, so narrower
# spacing would let one run's eval keys collide with another's training keys.
R=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
BASE=$(( R % 1000000000 ))

# The tuned Battleship configuration (paper architecture, SAC entropy off, actor
# gradient kept out of the shared memory, Retrace targets, small LD weight).
ARGS="--rows $ROWS --cols $COLS --ship-lengths $SHIPS
      --paper-arch --stop-actor-fe
      --retrace
      --expert-prefill-steps $PREFILL
      --actor-lr 1e-4 --critic-lr 1e-4 --fe-lr 1e-5
      --tau 0.005 --alpha 0.22
      --sequence-length 200 --burn-in-length 10 --batch-size 34
      --online-buffer-size 100000
      --expert-prefill-epsilon 0.1
      --num-seeds $NUM_SEEDS
      --rounds $ROUNDS
      --train-steps $TRAIN_STEPS
      --probe-eval-interval $PROBE_EVAL_INTERVAL
      --probe-eval-steps 20000
      --probe-eval-collect-steps 10000
      --collect-steps 20000
      --probe-steps 50000
      --no-probe-eval-vis
      $OFFLINE
      --wandb"

echo "job $SLURM_JOB_ID on $(hostname)  base seed $BASE"
echo "board ${ROWS}x${COLS} ships $SHIPS, ${PREFILL} expert prefill steps ${OFFLINE:+(offline)}"

pids=()
for i in 0 1 2 3; do
    name=${NAMES[$i]}
    seed=$(( BASE + i * 1000000 ))
    out=$RUNDIR/gpu$i-$name
    mkdir -p "$out"
    echo "gpu$i -> $name: ${EXTRA[$i]}, seeds $seed..$((seed + NUM_SEEDS - 1))  ($out)"
    CUDA_VISIBLE_DEVICES=$i python -u "$SCRIPT" $ARGS ${EXTRA[$i]} \
        --seed "$seed" \
        --output-dir "$out" \
        --wandb-run-name "bbp-$name-$SLURM_JOB_ID-g$i-s$seed" \
        > "$out/run.log" 2>&1 &
    pids+=($!)
done

rc=0
for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || { rc=1; echo "gpu$i (${NAMES[$i]}) FAILED — see $RUNDIR/gpu$i-${NAMES[$i]}/run.log"; }
done
echo "done, rc=$rc  (artefacts under $RUNDIR)"
exit $rc
