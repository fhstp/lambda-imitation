#!/bin/bash -l
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#SBATCH --gpus-per-node=4
#SBATCH --time=06:00:00
#SBATCH --account=p201442
#SBATCH --partition=gpu
#SBATCH --qos=short
#SBATCH --job-name=pocman-lambda
#SBATCH --output=%x-%j.out

# PocMan lambda-discrepancy sweep: one GPU per --lambda-coef value, same seeds
# and same everything else, so the only difference between the four runs is the
# weight on the LD term.  Mirrors job.slrm (4 processes on one 4-GPU node).
#
# qos=short caps at 06:00:00; for a longer sweep use  --qos=default  (2 days)
# or  --qos=long  (6 days) and raise --time to match.

source ~/envs/py314.sh
export OMP_NUM_THREADS=32                  # 128 cores / 4 processes

# ── knobs ────────────────────────────────────────────────────────────────────
LAMBDAS=(0.0 0.01 0.1 1.0)                 # one per GPU; 0.0 = SAC control
ROUNDS=50
TRAIN_STEPS=10000                          # 500k env steps per seed
NUM_SEEDS=3                                # seeds per GPU, trained concurrently
PROBE_EVAL_INTERVAL=10                     # probe the memory every N rounds
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT=~/git/lambda-imitation/examples/lambda-envs/pocman_pellet_probe.py
RUNDIR=~/runs/$SLURM_JOB_ID
mkdir -p "$RUNDIR"

# Random base seed per submission.  Processes are spaced 1e6 apart: the probe
# derives its keys as seed+40000 / seed+50000 / seed+500000, so narrower
# spacing would let one run's eval keys collide with another's training keys.
R=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
BASE=$(( R % 1000000000 ))

# Everything except --lambda-coef is identical across the four runs.
# Network and lambda pair reproduce the reference implementation's PocMan agent
# (DiscreteActorCriticRNN, hidden_size 512, action_concat; lambdas 0.5/0.95 from
# pocman_LD_ppo_best.py).  These are the defaults now, passed explicitly so the
# job file records what was run.
ARGS="--paper-arch --memory-type gru --memory-hidden-dim 512
      --lambda1 0.5 --lambda2 0.95
      --sequence-length 20 --burn-in-length 32 --batch-size 512
      --online-buffer-size 200000
      --gamma 0.95 --tau 0.006
      --fe-lr 7e-5 --actor-lr 6e-5 --critic-lr 2e-4
      --retrace
      --num-seeds $NUM_SEEDS
      --rounds $ROUNDS
      --train-steps $TRAIN_STEPS
      --probe-eval-interval $PROBE_EVAL_INTERVAL
      --probe-eval-steps 20000
      --probe-eval-collect-steps 10000
      --collect-steps 20000
      --probe-steps 50000
      --no-probe-eval-vis
      --wandb"

echo "job $SLURM_JOB_ID on $(hostname)  base seed $BASE"
echo "lambda-coef values: ${LAMBDAS[*]}"

pids=()
for i in 0 1 2 3; do
    lc=${LAMBDAS[$i]}
    seed=$(( BASE + i * 1000000 ))
    out=$RUNDIR/gpu$i-lc$lc
    mkdir -p "$out"
    echo "gpu$i -> --lambda-coef $lc, seeds $seed..$((seed + NUM_SEEDS - 1))  ($out)"
    CUDA_VISIBLE_DEVICES=$i python -u "$SCRIPT" $ARGS \
        --lambda-coef "$lc" \
        --seed "$seed" \
        --output-dir "$out" \
        --wandb-run-name "pocman-lc$lc-$SLURM_JOB_ID-g$i-s$seed" \
        > "$out/run.log" 2>&1 &
    pids+=($!)
done

rc=0
for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || { rc=1; echo "gpu$i (lambda-coef ${LAMBDAS[$i]}) FAILED — see $RUNDIR/gpu$i-lc${LAMBDAS[$i]}/run.log"; }
done
echo "done, rc=$rc  (artefacts under $RUNDIR)"
exit $rc
